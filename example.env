# ──────────────────────────────────────────────────────────────────────────
# example.env  →  copy to .env with:  python scripts/init_env.py
# .env is git-ignored. NEVER commit real secrets.
#
# Secrets (the *_API_KEY style values) can be given two ways:
#   1. directly:         TAVILY_API_KEY=tvly-abc123
#   2. as a vault ref:   TAVILY_API_KEY=secret://TAVILY_API_KEY
#      (resolved from Google Secret Manager at runtime)
# Values that still look like placeholders are treated as "not set".
# ──────────────────────────────────────────────────────────────────────────

# ── Secrets vault ─────────────────────────────────────────────────────────
# env = read only from this file / the environment (local dev)
# gcp = ALSO fall back to Google Secret Manager for any secret not set here
SECRETS_BACKEND=env

# ── Secrets (placeholders = not set) ──────────────────────────────────────
TAVILY_API_KEY=your-tavily-key-here
# Only needed when GOOGLE_USE_VERTEX=false (AI Studio key). Not needed with Vertex.
GOOGLE_API_KEY=your-gemini-api-key-here

# ── Model ─────────────────────────────────────────────────────────────────
# Any "provider:model" string LangChain's init_chat_model understands.
# Set this to a model your key can use (check Google AI Studio for current names).
# NOTE: the production agent now takes its models from config/policy.yaml (models.default / models.allowed); callers pick one per request.
# MODEL below is only used by tooling/tests that build a fixed model.
MODEL=google_genai:gemini-2.5-flash
# true  = call Gemini through Vertex AI using your GCP credentials (ADC / service account): no API key
# false = call Gemini with GOOGLE_API_KEY (AI Studio)
GOOGLE_USE_VERTEX=true
# Optional: some Gemini models are served from a different location than GCP_LOCATION (e.g. global)
MODEL_LOCATION=
# Limits for ONE model call (the client's own defaults are: no timeout, 6 retries with growing waits)
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3

# ── GCP ───────────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# ── Sandbox (Agent Platform shell sandbox) ────────────────────────────────
# Leave SANDBOX_RUNTIME empty on first run: one is created and its name is
# printed. Paste it here so later runs reuse it.
SANDBOX_RUNTIME=
# Optional: attach to an existing sandbox instead of creating one
SANDBOX_NAME=
SANDBOX_TTL_SECONDS=3600
SANDBOX_CWD=/workspace

# ── Skills ────────────────────────────────────────────────────────────────
# Where skills live. Either a Cloud Storage prefix or a local folder (dev):
#   SKILLS_SOURCE=gs://my-bucket/skills
#   SKILLS_SOURCE=./skills_example
SKILLS_SOURCE=./skills_example

# ── Guardrails ────────────────────────────────────────────────────────────
# allowlist = only listed commands may run (recommended)
# denylist  = anything not explicitly dangerous may run
COMMAND_POLICY=allowlist
MAX_PROMPT_CHARS=8000

# ── Approvals ─────────────────────────────────────────────────────────────
# none    = run without asking
# execute = ask a human before every shell command
APPROVAL_MODE=none

# ── State & API (Phase 2) ─────────────────────────────────────────────────
# memory   = lost on restart (fine for `pinboard run`, NOT for approvals that must survive a restart)
# postgres = durable: runs, approvals, audit trail and the LangGraph checkpoints
STATE_BACKEND=memory
# Only for STATE_BACKEND=postgres. Contains a password: treat as a secret (secret://DATABASE_URL works).
#   local docker : postgresql://postgres:postgres@localhost:5432/pinboard
#   Cloud SQL    : postgresql://USER:PASS@/pinboard?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=your-database-url-here
# Bearer token clients must send to the API. Generate one:  openssl rand -hex 32
PINBOARD_API_TOKEN=your-api-token-here
# How long a parked action waits for a decision. Must be <= SANDBOX_TTL_SECONDS - 300.
APPROVAL_TTL_SECONDS=1200
PINBOARD_USER_ID=owner
# Let the Agent Runtime contract routes skip the bearer check because the PLATFORM authenticates
# callers. Only set true when the service is NOT publicly reachable.
TRUST_PLATFORM_AUTH=false

# ── Tools ─────────────────────────────────────────────────────────────────
TAVILY_MAX_RESULTS=5

# ── Outputs ───────────────────────────────────────────────────────────────
# The sandbox is deleted after every run. Files the agent saves in /workspace/out are
# downloaded to OUTPUT_DIR/<run id>/ before that happens.
OUTPUT_DIR=./outputs
# Optional: ALSO copy them to Cloud Storage, e.g. gs://my-bucket/outputs
OUTPUTS_GCS_URI=

# ── Connectors (Phase 2) ──
# AGENTMAIL_API_KEY goes in the secrets section (placeholder there); the PEM lives in Secret Manager as GITHUB_APP_PRIVATE_KEY
GITHUB_APP_ID=your-github-app-id
GITHUB_INSTALLATION_ID=
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to
AGENTMAIL_API_KEY=your-agentmail-key-here
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key-here

# ── Artifacts (files the agent produces, kept per user) ───────────────────
# gs://bucket/prefix in the cloud, or a local folder in development. Bytes are stored under users/<hash of user>/artifacts/...
ARTIFACTS_URI=./artifacts
